{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/Rvhoyos/SimpleTrading"
  },
  "license": "${license}",
  "icon": "assets/simpletrading/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mc.simpletrading.fabric.SimpleTradingFabric"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~1.20.1",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
